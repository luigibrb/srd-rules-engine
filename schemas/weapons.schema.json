{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "default": "homebrew",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "simple",
            "martial"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "melee",
            "ranged"
          ]
        },
        "damage": {
          "type": "string"
        },
        "damage_type": {
          "type": "string"
        },
        "properties": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versatile_damage": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "mastery": {
          "type": "string"
        },
        "weight": {
          "default": "",
          "type": "string"
        },
        "cost": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "kind",
        "damage",
        "damage_type",
        "mastery"
      ],
