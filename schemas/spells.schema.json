{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "default": "homebrew",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "school": {
          "type": "string"
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "casting_time": {
          "type": "string"
        },
        "ritual": {
          "default": false,
          "type": "boolean"
        },
        "range": {
          "type": "string"
        },
        "components": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "concentration": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "level",
        "school",
        "lists",
        "casting_time",
        "range",
        "components",
        "duration"
      ],
      "additionalProperties": false
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "default": "homebrew",
            "type": "string"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "school": {
            "type": "string"
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "casting_time": {
            "type": "string"
          },
          "ritual": {
            "default": false,
            "type": "boolean"
          },
          "range": {
            "type": "string"
          },
          "components": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "concentration": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "level",
          "school",
          "lists",
          "casting_time",
          "range",
          "components",
          "duration"
        ],
        "additionalProperties": false
      }
    }
  ],
  "title": "spells content"
}
