{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MovePreview",
  "$defs": {
    "MovePreview": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "movement_left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "creature": {
                "type": "string"
              },
              "at": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "kind": {
                "type": "string",
                "enum": [
                  "enters",
                  "moves_in"
                ]
              },
              "feet": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "zone",
              "label",
              "creature",
              "at",
              "kind",
              "feet"
            ],
            "additionalProperties": false
          }
        },
        "opportunity_attacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "reasons",
        "path",
        "cost",
        "movement_left",
        "zones",
        "opportunity_attacks"
      ],
      "additionalProperties": false
    }
  },
  "title": "Move preview"
}
