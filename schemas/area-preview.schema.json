{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AreaPreview",
  "$defs": {
    "AreaPreview": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "squares": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "cover": {
                "type": "string",
                "enum": [
                  "none",
                  "half",
                  "three_quarters"
                ]
              },
              "by": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "cover",
              "by"
            ],
            "additionalProperties": false
          }
        },
        "total_cover": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "reasons",
        "squares",
        "targets",
        "total_cover"
      ],
      "additionalProperties": false
    }
  },
  "title": "Area preview"
}
