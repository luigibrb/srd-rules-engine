{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Reachable",
  "$defs": {
    "Reachable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "movement": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "squares": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "cost": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y",
              "cost"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "movement",
        "squares"
      ],
      "additionalProperties": false
    }
  },
  "title": "Reachable squares"
}
