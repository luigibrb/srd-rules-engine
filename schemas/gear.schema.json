{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "default": "homebrew",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "cost": {
          "default": "",
          "type": "string"
        },
        "weight": {
          "default": "",
          "type": "string"
        },
        "bundle": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "default": "homebrew",
            "type": "string"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "cost": {
            "default": "",
            "type": "string"
          },
          "weight": {
            "default": "",
            "type": "string"
          },
          "bundle": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  ],
  "title": "gear content"
}
