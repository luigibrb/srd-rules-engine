{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PackManifest",
  "$defs": {
    "PackManifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "version": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "ruleset": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "requires": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          }
        },
        "description": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  "title": "Content pack manifest"
}
