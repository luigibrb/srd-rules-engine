{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "default": "srd-5.2.1",
      "type": "string"
    },
    "standard_array": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "point_buy": {
      "type": "object",
      "properties": {
        "budget": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "min_score": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "max_score": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "costs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "budget",
        "min_score",
        "max_score",
        "costs"
      ],
      "additionalProperties": false
    },
    "max_score_at_creation": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "base_grants": {
      "$ref": "#/$defs/Grants"
    }
  },
  "required": [
    "standard_array",
    "point_buy",
    "max_score_at_creation",
    "base_grants"
  ],
  "additionalProperties": false,
  "$defs": {
    "Grants": {
      "type": "object",
      "properties": {
        "size": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "small",
                "medium"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skills": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "acrobatics",
              "animal-handling",
              "arcana",
              "athletics",
              "deception",
              "history",
              "insight",
              "intimidation",
              "investigation",
              "medicine",
              "nature",
              "perception",
              "performance",
              "persuasion",
              "religion",
              "sleight-of-hand",
              "stealth",
              "survival"
            ]
          }
        },
        "tools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "saving_throws": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          }
        },
        "armor_training": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weapon_proficiencies": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feats": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feat": {
                "type": "string"
              },
              "params": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "feat"
            ],
            "additionalProperties": false
          }
        },
        "resistances": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cantrips": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "op": {
                "default": "add",
                "type": "string",
                "enum": [
                  "add",
                  "set",
                  "max"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "const": "prof"
                  }
                ]
              },
              "when": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "target",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "items": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string"
              },
              "qty": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "item"
            ],
            "additionalProperties": false
          }
        },
        "gp": {
          "default": 0,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "traits": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "choices": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoiceDef"
          }
        }
      },
      "additionalProperties": false
    },
    "ChoiceDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "option",
            "ability",
            "skill",
            "tool",
            "skill_or_tool",
            "language",
            "feat",
            "weapon_mastery"
          ]
        },
        "count": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "options": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          }
        },
        "allowed": {
          "default": null,
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "class",
                "species",
                "background",
                "abilities",
                "equipment",
                "features",
                "proficiencies",
                "languages",
                "details"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "additionalProperties": false
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "grants": {
          "default": {},
          "$ref": "#/$defs/Grants"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "title": "Character creation rules"
}
